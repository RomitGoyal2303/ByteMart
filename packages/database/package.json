{
  "name": "@bytemart/database",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "format-and-lint": "biome check ./src",
    "format-and-lint:fix": "biome check --write ./src",
    "with-env": "dotenv -e ../../.env --",
    "db:migrate": "pnpm with-env tsx ./src/scripts/migration.ts",
    "db:studio": "pnpm with-env drizzle-kit studio",
    "db:generate": "pnpm with-env drizzle-kit generate",
    "db:seed": "pnpm with-env tsx ./src/scripts/seed.ts"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.2.2",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "drizzle-seed": "^0.3.1",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.0",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3"
  }
}
